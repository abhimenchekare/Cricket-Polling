# ─────────────────────────────────────────────────────────────
#  Cricket Auction — Live Polling (Vercel + Postgres)
#  Copy to .env for local testing. On Vercel set these in
#  Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Neon / Vercel Postgres / Supabase).
# Vercel's Neon integration can inject this automatically.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# First-run admin account (created only if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Auction Control Room

# Session lifetime
ADMIN_SESSION_HOURS=12
PARTICIPANT_SESSION_DAYS=7

# Default countdown for new polls (seconds) — "10", "15", "30" etc.
DEFAULT_TIMER_SECONDS=30

# Optional: absolute URL shown in the share link.
# Leave blank on Vercel (it is detected automatically).
PUBLIC_BASE_URL=

# Local dev only
PORT=4000
